# =====================================================================
# Fleet Ping Service - Example environment configuration
# ---------------------------------------------------------------------
# Copy to `.env` for local development and fill in real values.
# NEVER commit a real `.env`. In production these values are injected
# from Azure Key Vault via Managed Identity (see terraform/ and k8s/),
# NOT from a file baked into the image.
# =====================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Comma-separated allowed CORS origins (empty = none)
CORS_ORIGINS=

# ---- Database (Azure Database for PostgreSQL - Flexible Server) ----
# Prefer discrete vars so the password can come from Key Vault on its own.
PGHOST=localhost
PGPORT=5432
PGDATABASE=vexar_fleet
PGUSER=fleet_app
PGPASSWORD=change-me-locally-only
# require | verify-full  (use verify-full against Azure PostgreSQL)
PGSSLMODE=disable

# ---- Connection pool ----
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000

# ---- Auth ----
# Generate a strong random value; in prod this comes from Key Vault.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
