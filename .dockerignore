# Keep the build context small, fast, and free of secrets.

# Dependencies (reinstalled inside the image)
node_modules
npm-debug.log*

# Version control & CI
.git
.github
.gitignore

# Secrets / local env  (must never enter an image layer)
.env
.env.*
!.env.example
*.pem
*.key
*.tfvars

# Infrastructure & docs (not needed at runtime)
terraform
k8s
helm
docs
*.md
!README.md

# Local tooling / test / coverage
coverage
.nyc_output
.vscode
.idea
.DS_Store
Dockerfile
docker-compose.yml
